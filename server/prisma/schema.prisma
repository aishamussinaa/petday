generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime  @default(now())
  pets         Pet[]
  sessions     Session[]
}

model Session {
  tokenHash String   @id @db.Char(64)
  csrfToken String   @db.VarChar(64)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model Pet {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String   @db.VarChar(80)
  species          String   @db.VarChar(20)
  breed            String   @default("") @db.VarChar(120)
  sex              String   @default("unknown") @db.VarChar(12)
  birthDate        DateTime? @db.Date
  birthApproximate Boolean  @default(false)
  features         String   @default("") @db.VarChar(2000)
  allergies        String   @default("") @db.VarChar(2000)
  notes            String   @default("") @db.VarChar(4000)
  tasks            CareTask[]
  photoKey         String?  @unique @db.VarChar(64)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([userId, createdAt])
}

model RateLimit {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model CareTask {
  id String @id @db.Uuid
  petId String @db.Uuid
  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  day DateTime @db.Date
  title String @db.VarChar(120)
  category String @db.VarChar(12)
  time String @default("") @db.VarChar(5)
  notes String @default("") @db.VarChar(1000)
  completedAt DateTime?
  deletedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events CareEvent[]
  @@index([petId, day])
}
model CareEvent {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task CareTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action String @db.VarChar(16)
  title String @db.VarChar(120)
  version Int
  createdAt DateTime @default(now())
  @@unique([taskId, version])
  @@index([createdAt])
}
