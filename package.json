{
  "name": "petday",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs",
    "db:cleanup": "node --env-file-if-exists=.env scripts/cleanup-uploads.mjs",
    "test:unit": "node --test tests/server-unit.test.mjs tests/postgres-recovery.test.cjs tests/birthday.test.mjs",
    "test": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "10.0.6",
    "prisma": "7.10.1"
  },
  "type": "module"
}
